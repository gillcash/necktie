{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/necktie-context.js\" SessionStart",
            "additionalContextLimit": 2400
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/necktie-context.js\" SubagentStart",
            "additionalContextLimit": 2400
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/necktie-context.js\" UserPromptSubmit",
            "additionalContextLimit": 2400
          }
        ]
      }
    ]
  }
}
